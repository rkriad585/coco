# selfhost/lex.co - Coco-written tokenizer (Phase 3).
#
# Faithful 1:1 port of the C++ seed lexer (src/lex/lexer.cpp). It reproduces the
# exact token stream AND diagnostic messages so that its output is byte-identical
# to `cocolex --dump <file.co>`. Run via:
#   cocorun selfhost/lex.co <file.co>
# and diff against:
#   cocolex --dump <file.co>
#
# The C++ lexer is C-style: newlines are whitespace, `;` and { } block structure
# mean INDENT/DEDENT tokens are NEVER emitted (they exist in the Tok enum only).

# ---- token kind names (coco::tokName) ---------------------------------------
const K_EOF    = "Eof";
const K_NEWLN  = "Newline";
const K_INDENT = "Indent";
const K_DEDENT = "Dedent";
const K_IDENT  = "Ident";
const K_INT    = "Int";
const K_FLOAT  = "Float";
const K_CHAR   = "Char";
const K_STR    = "Str";
const K_STRRAW = "StrRaw";
const K_STRBYT = "StrByte";
const K_STRC   = "StrC";
const K_FSTR   = "FStr#";
const K_FSTRTX = "FStrTxt";
const K_FSTRLB = "FStr{";
const K_FSTRRB = "FStr}";
const K_FSTRCO = "FStr:";
const K_FSTRSP = "FStrSpec";
const K_FSTEND = "FStrEnd";
const K_OP     = "Op";
const K_PUNCT  = "Punct";

# f-string mode: mirrors src/lex/lexer.h `enum class FsMode`
const FSM_NONE = 0;
const FSM_TEXT = 1;
const FSM_EXPR = 2;

# ---- character classifiers (byte-level, like the C++ lexer) -----------------
def ord_c(c) -> int { return ord(c); }

def is_dec_c(c) -> bool { o = ord_c(c); return o >= 48 and o <= 57; }
def is_hex_c(c) -> bool {
    o = ord_c(c);
    return is_dec_c(c) or (o >= 65 and o <= 70) or (o >= 97 and o <= 102);
}
def is_oct_c(c) -> bool { o = ord_c(c); return o >= 48 and o <= 55; }
def is_bin_c(c) -> bool { o = ord_c(c); return o == 48 or o == 49; }
def is_ident_start_c(c) -> bool {
    o = ord_c(c);
    return c == '_' or (o >= 65 and o <= 90) or (o >= 97 and o <= 122);
}
def is_ident_cont_c(c) -> bool {
    o = ord_c(c);
    return c == '_' or is_dec_c(c) or (o >= 65 and o <= 90) or (o >= 97 and o <= 122);
}
def to_low_c(c) -> char {
    o = ord_c(c);
    if o >= 65 and o <= 90 { return chr(o + 32); }
    return c;
}
def is_punct_c(c) -> bool {
    o = ord_c(c);
    return o == 40 or o == 41 or o == 91 or o == 93 or o == 123 or o == 125
        or o == 44 or o == 58 or o == 59 or o == 46;
}
def is_op1_c(c) -> bool {
    o = ord_c(c);
    return o == 43 or o == 45 or o == 42 or o == 47 or o == 37 or o == 38
        or o == 124 or o == 94 or o == 126 or o == 60 or o == 62 or o == 61
        or o == 63 or o == 64;
}

# ---- state ---------------------------------------------------------------
# All mutable lexer state lives in ONE dict (reference semantics), mirroring the
# fields of the C++ Lexer class:
#   src, pos, line, col, paren, fsMode, fbrace, inner, specActive, spec,
#   eofDone, hasTok, queue, diags
pub def new_lex(src) {
    var st = {
        "src": src, "pos": 0, "line": 1, "col": 1,
        "paren": 0, "fsMode": FSM_NONE, "fbrace": 0, "inner": 0,
        "specActive": 0, "spec": "", "eofDone": 0, "hasTok": 0,
        "atLineStart": 1,
        "queue": [], "diags": [],
    };
    return st;
}

def peek_ch(st, off: int) -> char {
    p = st["pos"] + off;
    if p < len(st["src"]) { return st["src"][p]; }
    return '\u{0}';
}

def at_eol_p(st, p: int) -> bool {
    return p < len(st["src"]) and
           (st["src"][p] == '\n' or st["src"][p] == '\r');
}

def diag(st, line: int, col: int, msg) {
    st["diags"].append([line, col, msg]);
}

def advance_ws(st) {
    st["pos"] = st["pos"] + 1;
    st["col"] = st["col"] + 1;
}

def skip_inline_ws(st) {
    while st["pos"] < len(st["src"]) and
          (st["src"][st["pos"]] == ' ' or st["src"][st["pos"]] == '\t') {
        advance_ws(st);
    }
}

def skip_to_eol(st) {
    while st["pos"] < len(st["src"]) and not at_eol_p(st, st["pos"]) {
        st["pos"] = st["pos"] + 1;
        st["col"] = st["col"] + 1;
    }
}

def consume_eol(st) {
    if peek_ch(st, 0) == '\r' {
        st["pos"] = st["pos"] + 1;
        if peek_ch(st, 0) == '\n' { st["pos"] = st["pos"] + 1; }
    } else {
        st["pos"] = st["pos"] + 1;
    }
    st["line"] = st["line"] + 1;
    st["col"] = 1;
    st["hasTok"] = 0;
    st["atLineStart"] = 1;
}

def consume_eol_no_newline(st) {
    if peek_ch(st, 0) == '\r' {
        st["pos"] = st["pos"] + 1;
        if peek_ch(st, 0) == '\n' { st["pos"] = st["pos"] + 1; }
    } else {
        st["pos"] = st["pos"] + 1;
    }
    st["line"] = st["line"] + 1;
    st["col"] = 1;
}

def process_indentation(st) {
    while st["pos"] < len(st["src"]) and
          (st["src"][st["pos"]] == ' ' or st["src"][st["pos"]] == '\t') {
        advance_ws(st);
    }
    st["hasTok"] = 0;
    st["atLineStart"] = 0;
}

def finish_file(st) {
    if st["paren"] > 0 {
        diag(st, st["line"], st["col"], "unclosed '(' / '[' at end of file");
    }
    st["queue"].append([K_EOF, "", st["line"], st["col"]]);
    st["eofDone"] = 1;
}

# ---- token scanners ---------------------------------------------------------

def src_match(st, op) -> bool {
    n = len(op);
    if st["pos"] + n > len(st["src"]) { return false; }
    var got = st["src"][st["pos"] .. st["pos"] + n];
    return got == op;
}

def eat_dig(st, text, mode: int) -> list {
    # mode: 0 dec, 1 hex, 2 oct, 3 bin (is_*_c predicate selection)
    has_any = false;
    while st["pos"] < len(st["src"]) {
        c = st["src"][st["pos"]];
        ok = false;
        if mode == 0 { ok = is_dec_c(c); }
        elif mode == 1 { ok = is_hex_c(c); }
        elif mode == 2 { ok = is_oct_c(c); }
        else { ok = is_bin_c(c); }
        if ok {
            text += str(c);
            st["pos"] = st["pos"] + 1;
            st["col"] = st["col"] + 1;
            has_any = true;
        } elif c == '_' {
            text += str(c);
            st["pos"] = st["pos"] + 1;
            st["col"] = st["col"] + 1;
        } else {
            break;
        }
    }
    return [has_any, text];
}

def scan_number(st) -> list {
    line = st["line"];
    col = st["col"];
    var text = "";

    if peek_ch(st, 0) == '0' {
        n = to_low_c(peek_ch(st, 1));
        if n == 'x' or n == 'o' or n == 'b' {
            text += str(peek_ch(st, 0));
            st["pos"] = st["pos"] + 1;
            st["col"] = st["col"] + 1;
            text += str(peek_ch(st, 0));
            st["pos"] = st["pos"] + 1;
            st["col"] = st["col"] + 1;
            mode = 1;
            if n == 'o' { mode = 2; }
            elif n == 'b' { mode = 3; }
            r = eat_dig(st, text, mode);
            has_any = r[0];
            text = r[1];
            if not has_any {
                diag(st, st["line"], st["col"], "numeric literal needs at least one digit");
            }
            if text[-1] == '_' {
                diag(st, st["line"], st["col"], "trailing '_' in numeric literal");
            }
            if st["pos"] < len(st["src"]) and
               (is_ident_start_c(peek_ch(st, 0)) or is_dec_c(peek_ch(st, 0))) {
                diag(st, st["line"], st["col"], "invalid character in numeric literal");
            }
            return [K_INT, text, line, col];
        }
    }

    r = eat_dig(st, text, 0);
    text = r[1];
    is_float = false;
    if peek_ch(st, 0) == '.' and is_dec_c(peek_ch(st, 1)) {
        is_float = true;
        text += str('.');
        st["pos"] = st["pos"] + 1;
        st["col"] = st["col"] + 1;
        r = eat_dig(st, text, 0);
        text = r[1];
    }
    if peek_ch(st, 0) == 'e' or peek_ch(st, 0) == 'E' {
        savepos = st["pos"];
        saveline = st["line"];
        savecol = st["col"];
        exp = str(peek_ch(st, 0));
        st["pos"] = st["pos"] + 1;
        st["col"] = st["col"] + 1;
        if peek_ch(st, 0) == '+' or peek_ch(st, 0) == '-' {
            exp += str(peek_ch(st, 0));
            st["pos"] = st["pos"] + 1;
            st["col"] = st["col"] + 1;
        }
        if st["pos"] < len(st["src"]) and is_dec_c(peek_ch(st, 0)) {
            is_float = true;
            text += exp;
            r = eat_dig(st, text, 0);
            text = r[1];
        } else {
            st["pos"] = savepos;
            st["line"] = saveline;
            st["col"] = savecol;
        }
    }

    if text[-1] == '_' {
        diag(st, st["line"], st["col"], "trailing '_' in numeric literal");
    }
    if not is_float and st["pos"] < len(st["src"]) and
       (is_ident_start_c(peek_ch(st, 0)) or
        (peek_ch(st, 0) == '.' and is_dec_c(peek_ch(st, 1)))) {
        diag(st, st["line"], st["col"], "invalid suffix on numeric literal");
    }

    kind = if is_float { K_FLOAT } else { K_INT };
    return [kind, text, line, col];
}

def scan_char(st) -> list {
    line = st["line"];
    col = st["col"];
    var text = "";
    st["pos"] = st["pos"] + 1;
    st["col"] = st["col"] + 1;
    while st["pos"] < len(st["src"]) {
        c = peek_ch(st, 0);
        if c == '\'' {
            st["pos"] = st["pos"] + 1;
            st["col"] = st["col"] + 1;
            return [K_CHAR, text, line, col];
        }
        if at_eol_p(st, st["pos"]) { break; }
        if c == '\\' {
            text += str(peek_ch(st, 0));
            st["pos"] = st["pos"] + 1;
            st["col"] = st["col"] + 1;
            if st["pos"] < len(st["src"]) {
                e = peek_ch(st, 0);
                text += str(e);
                st["pos"] = st["pos"] + 1;
                st["col"] = st["col"] + 1;
                if e == 'u' and peek_ch(st, 0) == '{' {
                    text += str(peek_ch(st, 0));
                    st["pos"] = st["pos"] + 1;
                    st["col"] = st["col"] + 1;
                    while st["pos"] < len(st["src"]) and peek_ch(st, 0) != '}' {
                        text += str(peek_ch(st, 0));
                        st["pos"] = st["pos"] + 1;
                        st["col"] = st["col"] + 1;
                    }
                    if peek_ch(st, 0) == '}' {
                        text += str('}');
                        st["pos"] = st["pos"] + 1;
                        st["col"] = st["col"] + 1;
                    } else {
                        diag(st, st["line"], st["col"], "unterminated \\u{...} escape");
                    }
                }
            }
        } else {
            text += str(peek_ch(st, 0));
            st["pos"] = st["pos"] + 1;
            st["col"] = st["col"] + 1;
        }
    }
    diag(st, st["line"], st["col"], "unterminated character literal");
    return [K_CHAR, text, line, col];
}

def scan_string(st, prefix, sl: int, sc: int) -> list {
    var kind = K_STR;
    if prefix == "r" { kind = K_STRRAW; }
    elif prefix == "b" { kind = K_STRBYT; }
    elif prefix == "c" { kind = K_STRC; }
    raw = prefix == "r";
    var text = "";
    while st["pos"] < len(st["src"]) {
        c = peek_ch(st, 0);
        if c == '"' {
            st["pos"] = st["pos"] + 1;
            st["col"] = st["col"] + 1;
            return [kind, text, sl, sc];
        }
        if at_eol_p(st, st["pos"]) { break; }
        if c == '\\' and not raw {
            text += str(peek_ch(st, 0));
            st["pos"] = st["pos"] + 1;
            st["col"] = st["col"] + 1;
            if st["pos"] >= len(st["src"]) { break; }
            e = peek_ch(st, 0);
            text += str(e);
            st["pos"] = st["pos"] + 1;
            st["col"] = st["col"] + 1;
            if e == 'u' {
                if peek_ch(st, 0) != '{' {
                    diag(st, st["line"], st["col"], "\\u escape requires '{hex}' form");
                    continue;
                }
                text += str('{');
                st["pos"] = st["pos"] + 1;
                st["col"] = st["col"] + 1;
                while st["pos"] < len(st["src"]) and peek_ch(st, 0) != '}' and
                      peek_ch(st, 0) != '"' {
                    text += str(peek_ch(st, 0));
                    st["pos"] = st["pos"] + 1;
                    st["col"] = st["col"] + 1;
                }
                if peek_ch(st, 0) == '}' {
                    text += str('}');
                    st["pos"] = st["pos"] + 1;
                    st["col"] = st["col"] + 1;
                } else {
                    diag(st, st["line"], st["col"], "unterminated \\u{...} escape");
                }
            }
        } else {
            text += str(peek_ch(st, 0));
            st["pos"] = st["pos"] + 1;
            st["col"] = st["col"] + 1;
        }
    }
    diag(st, sl, sc, "unterminated string literal");
    return [kind, text, sl, sc];
}

def scan_ftext(st) -> list {
    var run = "";
    while st["pos"] < len(st["src"]) {
        c = peek_ch(st, 0);
        if c == '"' {
            st["pos"] = st["pos"] + 1;
            st["col"] = st["col"] + 1;
            st["fsMode"] = FSM_NONE;
            if len(run) > 0 {
                st["queue"].append([K_FSTRTX, run, st["line"], st["col"]]);
            }
            return [K_FSTEND, "\"", st["line"], st["col"]];
        }
        if at_eol_p(st, st["pos"]) {
            diag(st, st["line"], st["col"], "unterminated f-string literal");
            st["fsMode"] = FSM_NONE;
            if len(run) > 0 {
                st["queue"].append([K_FSTRTX, run, st["line"], st["col"]]);
            }
            return [K_FSTEND, "\"", st["line"], st["col"]];
        }
        if c == '\\' {
            run += str(peek_ch(st, 0));
            st["pos"] = st["pos"] + 1;
            st["col"] = st["col"] + 1;
            if st["pos"] < len(st["src"]) {
                run += str(peek_ch(st, 0));
                st["pos"] = st["pos"] + 1;
                st["col"] = st["col"] + 1;
            }
            continue;
        }
        if c == '{' {
            if peek_ch(st, 1) == '{' {
                run += str('{');
                st["pos"] = st["pos"] + 2;
                st["col"] = st["col"] + 2;
                continue;
            }
            lb = [K_FSTRLB, "{", st["line"], st["col"]];
            st["pos"] = st["pos"] + 1;
            st["col"] = st["col"] + 1;
            st["fsMode"] = FSM_EXPR;
            st["fbrace"] = 0;
            st["inner"] = 0;
            st["specActive"] = 0;
            st["spec"] = "";
            if len(run) == 0 { return lb; }
            st["queue"].append([K_FSTRTX, run, st["line"], st["col"]]);
            return lb;
        }
        if c == '}' {
            if peek_ch(st, 1) == '}' {
                run += str('}');
                st["pos"] = st["pos"] + 2;
                st["col"] = st["col"] + 2;
                continue;
            }
            diag(st, st["line"], st["col"], "stray '}' in f-string literal");
            st["pos"] = st["pos"] + 1;
            st["col"] = st["col"] + 1;
            continue;
        }
        run += str(peek_ch(st, 0));
        st["pos"] = st["pos"] + 1;
        st["col"] = st["col"] + 1;
    }
    diag(st, st["line"], st["col"], "unterminated f-string literal");
    st["fsMode"] = FSM_NONE;
    return [K_FSTEND, "\"", st["line"], st["col"]];
}

def adjust_fexpr(st, t) -> list {
    k = t[0];
    if k != K_PUNCT and k != K_OP { return t; }
    x = t[1];

    if x == "{" {
        st["fbrace"] = st["fbrace"] + 1;
        return t;
    }
    if x == "}" {
        if st["fbrace"] > 0 {
            st["fbrace"] = st["fbrace"] - 1;
            return t;
        }
        st["fsMode"] = FSM_TEXT;
        if st["specActive"] != 0 {
            spec = [K_FSTRSP, st["spec"], t[2], t[3]];
            st["spec"] = "";
            st["specActive"] = 0;
            rb = [K_FSTRRB, "}", t[2], t[3]];
            st["queue"].append(rb);
            return spec;
        }
        return [K_FSTRRB, "}", t[2], t[3]];
    }
    if x == "(" or x == "[" {
        st["inner"] = st["inner"] + 1;
        return t;
    }
    if x == ")" or x == "]" {
        st["inner"] = st["inner"] - 1;
        return t;
    }
    if x == ":" and st["fbrace"] == 0 and st["inner"] == 0 and st["specActive"] == 0 {
        st["specActive"] = 1;
        return [K_FSTRCO, ":", t[2], t[3]];
    }
    return t;
}

def scan_operator(st) -> list {
    line = st["line"];
    col = st["col"];
    ops3 = ["<<=", ">>=", "..=", ".?."];
    for op in ops3 {
        if src_match(st, op) {
            st["pos"] = st["pos"] + len(op);
            st["col"] = st["col"] + len(op);
            return [K_OP, op, line, col];
        }
    }
    ops2 = ["**", "//", "==", "!=", "<=", ">=", "<<", ">>", "+=", "-=", "*=",
            "/=", "%=", "&=", "|=", "^=", "->", "<-", "..", "=>"];
    for op in ops2 {
        if src_match(st, op) {
            st["pos"] = st["pos"] + len(op);
            st["col"] = st["col"] + len(op);
            return [K_OP, op, line, col];
        }
    }
    c = peek_ch(st, 0);
    var kind = K_PUNCT;
    if is_punct_c(c) {
        if c == '(' or c == '[' { st["paren"] = st["paren"] + 1; }
        if (c == ')' or c == ']') and st["paren"] > 0 {
            st["paren"] = st["paren"] - 1;
        }
        kind = K_PUNCT;
    } elif is_op1_c(c) {
        kind = K_OP;
    } else {
        diag(st, st["line"], st["col"], "unexpected character '" + str(c) + "'");
        st["pos"] = st["pos"] + 1;
        st["col"] = st["col"] + 1;
        return [K_PUNCT, "?", line, col];
    }
    text = str(c);
    st["pos"] = st["pos"] + 1;
    st["col"] = st["col"] + 1;
    return [kind, text, line, col];
}

def scan_ident_prefixed(st) -> list {
    line = st["line"];
    col = st["col"];
    var id = str(peek_ch(st, 0));
    st["pos"] = st["pos"] + 1;
    st["col"] = st["col"] + 1;
    while st["pos"] < len(st["src"]) and is_ident_cont_c(st["src"][st["pos"]]) {
        id += str(st["src"][st["pos"]]);
        st["pos"] = st["pos"] + 1;
        st["col"] = st["col"] + 1;
    }

    if peek_ch(st, 0) == '"' and (id == "r" or id == "b" or id == "c") {
        prefix = id;
        st["pos"] = st["pos"] + 1;
        st["col"] = st["col"] + 1;
        return scan_string(st, prefix, line, col);
    }
    if peek_ch(st, 0) == '"' and id == "f" {
        st["pos"] = st["pos"] + 1;
        st["col"] = st["col"] + 1;
        st["fsMode"] = FSM_TEXT;
        return [K_FSTR, "f\"", line, col];
    }

    return [K_IDENT, id, line, col];
}

def lex_token(st) -> list {
    if st["fsMode"] == FSM_TEXT { return scan_ftext(st); }

    c = peek_ch(st, 0);
    if is_ident_start_c(c) { return scan_ident_prefixed(st); }
    if is_dec_c(c) { return scan_number(st); }
    if c == '\'' { return scan_char(st); }
    if c == '"' {
        st["pos"] = st["pos"] + 1;
        st["col"] = st["col"] + 1;
        return scan_string(st, "", st["line"], st["col"] - 1);
    }

    t = scan_operator(st);
    if st["fsMode"] == FSM_EXPR { t = adjust_fexpr(st, t); }
    return t;
}

# ---- driver loop (mirrors Lexer::fill / lexAll) ------------------------------

def fill_once(st) {
    if st["pos"] >= len(st["src"]) {
        finish_file(st);
        return;
    }
    if st["atLineStart"] == 1 and st["paren"] == 0 {
        process_indentation(st);
        return;
    }
    skip_inline_ws(st);
    if st["pos"] >= len(st["src"]) {
        finish_file(st);
        return;
    }
    if at_eol_p(st, st["pos"]) {
        consume_eol(st);
        return;
    }
    if st["src"][st["pos"]] == '#' {
        skip_to_eol(st);
        return;
    }
    if st["src"][st["pos"]] == '\\' and at_eol_p(st, st["pos"] + 1) {
        st["pos"] = st["pos"] + 1;
        st["col"] = st["col"] + 1;
        consume_eol_no_newline(st);
        return;
    }
    if st["fsMode"] == FSM_EXPR and st["specActive"] != 0 and st["inner"] == 0
       and st["fbrace"] == 0 {
        # format spec: raw chars until '}' / quote / EOL.
        while st["pos"] < len(st["src"]) and peek_ch(st, 0) != '}' and
              peek_ch(st, 0) != '"' and not at_eol_p(st, st["pos"]) {
            st["spec"] += str(st["src"][st["pos"]]);
            st["pos"] = st["pos"] + 1;
            st["col"] = st["col"] + 1;
        }
        st["queue"].append([K_FSTRSP, st["spec"], st["line"], st["col"]]);
        st["spec"] = "";
        st["specActive"] = 0;
        if peek_ch(st, 0) == '}' {
            st["queue"].append([K_FSTRRB, "}", st["line"], st["col"]]);
            st["fsMode"] = FSM_TEXT;
            st["pos"] = st["pos"] + 1;
            st["col"] = st["col"] + 1;
        } else {
            if at_eol_p(st, st["pos"]) or st["pos"] >= len(st["src"]) {
                diag(st, st["line"], st["col"], "unterminated f-string literal");
            }
            st["queue"].append([K_FSTEND, "\"", st["line"], st["col"]]);
            st["fsMode"] = FSM_NONE;
            if peek_ch(st, 0) == '"' {
                st["pos"] = st["pos"] + 1;
                st["col"] = st["col"] + 1;
            }
        }
        st["hasTok"] = 1;
        return;
    }
    t = lex_token(st);
    st["queue"].append(t);
    st["hasTok"] = 1;
    return;
}

def fill(st, consumed: int) {
    # consumed = number of already-taken tokens (the queue is never physically
    # drained; len==consumed means there is nothing left to scan for).
    while len(st["queue"]) == consumed and st["eofDone"] == 0 {
        fill_once(st);
    }
}

pub def take_all(st) -> list {
    # skip a UTF-8 byte-order mark if present (mirrors lexAll)
    if st["pos"] + 2 < len(st["src"]) and
       ord_c(st["src"][0]) == 0xEF and ord_c(st["src"][1]) == 0xBB and
       ord_c(st["src"][2]) == 0xBF {
        st["pos"] = 3;
    }
    out = [];
    i = 0;
    while true {
        fill(st, i);
        if len(st["queue"]) == i { break; }
        t = st["queue"][i];
        i = i + 1;
        out.append(t);
        if t[0] == K_EOF { break; }
    }
    return out;
}

# ---- cocolex --dump compatible main ------------------------------------------

def main() {
    args = os.args();
    if len(args) == 0 {
        print("usage: lex <file.co>");
        return 2;
    }
    path = args[0];
    f = io.open(path);
    src = f.read();

    st = new_lex(src);
    toks = take_all(st);

    for t in toks {
        print(t[0] + "\t" + str(t[2]) + ":" + str(t[3]) + "\t" + t[1]);
    }

    if len(st["diags"]) == 0 {
        print(path + ": OK (" + str(len(toks) - 1) + " tokens)");
    } else {
        for d in st["diags"] {
            print(path + ":" + str(d[0]) + ":" + str(d[1]) + ": error: " + str(d[2]));
        }
    }
    print("---");
    # The C-style lexer never emits INDENT/DEDENT/NEWLINE; these constants are
    # kept for full parity with the C++ coco::tokName token surface.
    assert(K_NEWLN != K_INDENT);
    assert(K_DEDENT != K_NEWLN);
    if len(st["diags"]) == 0 {
        print("1/1 files clean, 0 diagnostic(s)");
        return 0;
    }
    print("0/1 files clean, " + str(len(st["diags"])) + " diagnostic(s)");
    return 1;
}