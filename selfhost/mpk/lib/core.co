# selfhost/lib/core.co - Coco-written compiler substrate (Phase 2).
# Small helpers that every later selfhost module shares. These mirror the
# behaviour of the C++ seed (src/interp/runtime.cpp, tools/cocolex.cpp) so
# differential tests stay byte-identical.

# Read an entire file as a string ("" if the file cannot be opened/read).
pub def read_file(path: string) -> string {
    f = io.open(path);
    s = f.read();
    f.close();
    return s;
}

# Write a string to a file (overwrites). No error feedback (matches io.write).
pub def write_file(path: string, data: string) {
    f = io.open(path);
    f.write(data);
    f.close();
}

# Integer -> string (runtime str() semantics; base 10).
pub def i2s(n: int) -> string {
    return str(n);
}

# Char -> string (single Unicode code point).
pub def c2s(c) -> string {
    return str(c);
}

# StringBuilder: amortized O(1) appends via a list of parts joined at to_str.
struct StringBuilder {
    parts: list = [];

    def append(self, s: string) {
        self.parts.append(s);
    }
    def add_c(self, c) {
        self.parts.append(str(c));
    }
    def to_str(self) -> string {
        out = "";
        for p in self.parts {
            out += str(p);
        }
        return out;
    }
}