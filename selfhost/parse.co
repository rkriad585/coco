# selfhost/parse.co - Coco-written parser + AST dumper (Phase 4).
#
# Faithful 1:1 port of the C++ seed parser (src/parser/parser.cpp) and AST
# pretty-printer (src/ast/ast_dump.cpp), reusing the self-hosted lexer
# (selfhost/lex.co). Reproduces `cocoparse --ast <file.co>` byte-for-byte.
#
#   cocorun selfhost/parse.co <file.co>         (mirrors cocoparse <file>)
#   cocorun selfhost/parse.co --ast <file.co>   (mirrors cocoparse --ast <file>)
#
# Parser state is a `p` dict {toks, idx, diags, bail}. AST nodes are tagged
# lists; see each constructor for its exact field layout.

import lex;
import lib.core;

# ---- token-kind name constants (coco::tokName strings) ---------------------
const K_EOF    = "Eof";
const K_NEWLN  = "Newline";
const K_INDENT = "Indent";
const K_DEDENT = "Dedent";
const K_IDENT  = "Ident";
const K_INT    = "Int";
const K_FLOAT  = "Float";
const K_CHAR   = "Char";
const K_STR    = "Str";
const K_STRRAW = "StrRaw";
const K_STRBYT = "StrByte";
const K_STRC   = "StrC";
const K_FSTR   = "FStr#";
const K_FSTRTX = "FStrTxt";
const K_FSTRLB = "FStr{";
const K_FSTRRB = "FStr}";
const K_FSTRCO = "FStr:";
const K_FSTRSP = "FStrSpec";
const K_FSTEND = "FStrEnd";
const K_OP     = "Op";
const K_PUNCT  = "Punct";

# ---- keyword set (grammar §1, frozen subset) -------------------------------
const KW = ["def", "pub", "extern", "struct", "enum", "trait", "impl", "import",
            "from", "export", "const", "var", "if", "elif", "else", "while",
            "for", "in", "match", "case", "select", "unsafe", "pass", "return",
            "raise", "break", "continue", "defer", "spawn", "yield", "as",
            "is", "fn", "new", "try", "not", "and", "or", "chan",
            "weak", "none", "true", "false", "self", "mut"];
def is_kw(w) -> bool {
    for k in KW {
        if k == w { return true; }
    }
    return false;
}
def is_aug_op(s) -> bool {
    return s == "+=" or s == "-=" or s == "*=" or s == "/=" or s == "%=" or
           s == "**=" or s == "//=" or s == "&=" or s == "|=" or s == "^=" or
           s == "<<=" or s == ">>=";
}
def is_cmp_tok(s) -> bool {
    return s == "<" or s == ">" or s == "<=" or s == ">=" or s == "==" or
           s == "!=" or s == "is" or s == "in";
}

# ---- parser core ------------------------------------------------------------
def new_parser(toks) -> dict {
    p = {};
    p["toks"] = toks;
    p["idx"] = 0;
    p["diags"] = [];
    p["bail"] = "";
    return p;
}

def pcur(p, off: int = 0) -> list {
    toks = p["toks"];
    i = p["idx"] + off;
    if i >= len(toks) { i = len(toks) - 1; }
    return toks[i];
}
def pat(p, k, off: int = 0) -> bool { return pcur(p, off)[0] == k; }
def patOp(p, op, off: int = 0) -> bool {
    c = pcur(p, off);
    return c[0] == K_OP and c[1] == op;
}
def patPunct(p, pp, off: int = 0) -> bool {
    c = pcur(p, off);
    return c[0] == K_PUNCT and c[1] == pp;
}
def patIdent(p, w, off: int = 0) -> bool {
    c = pcur(p, off);
    return c[0] == K_IDENT and c[1] == w;
}
def padv(p) -> list {
    t = pcur(p);
    if p["idx"] + 1 < len(p["toks"]) { p["idx"] = p["idx"] + 1; }
    return t;
}
def pskip_newlines(p) {
    while pat(p, K_NEWLN) { padv(p); }
}
def preport(p, line: int, col: int, msg) {
    p["diags"].append([line, col, msg]);
}
def perr(p, what) {
    p["bail"] = what;
    panic(what);
}
def pexpect(p, k, what) {
    c = pcur(p);
    if not pat(p, k) {
        found = if c[0] == K_NEWLN { "newline" } else { "'" + c[1] + "'" };
        preport(p, c[2], c[3], "expected " + what + ", found " + found);
        perr(p, "expect");
    }
    return padv(p);
}
def pexpect_op(p, op) {
    c = pcur(p);
    if not patOp(p, op) {
        preport(p, c[2], c[3], "expected '" + op + "', found '" + c[1] + "'");
        perr(p, "expectop");
    }
    return padv(p);
}
def pexpect_punct(p, pp) {
    c = pcur(p);
    if not patPunct(p, pp) {
        preport(p, c[2], c[3], "expected '" + pp + "', found '" + c[1] + "'");
        perr(p, "expectpunct");
    }
    return padv(p);
}
def pexpect_kind(p, k, what) {
    c = pcur(p);
    if not pat(p, k) {
        found = if c[0] == K_NEWLN { "newline" } else { "'" + c[1] + "'" };
        preport(p, c[2], c[3], "expected " + what + ", found " + found);
        perr(p, "expect");
    }
    return padv(p);
}
def psync_to_statement_end(p) {
    depth = 0;
    while not pat(p, K_EOF) {
        c = pcur(p);
        if c[0] == K_PUNCT {
            x = c[1];
            if x == "{" or x == "(" or x == "[" {
                depth = depth + 1;
            } elif x == "}" {
                if depth == 0 { padv(p); return; }
                depth = depth - 1;
            } elif x == ")" or x == "]" {
                if depth > 0 { depth = depth - 1; }
            } elif x == ";" and depth == 0 {
                padv(p);
                return;
            }
        }
        padv(p);
    }
}

# ---- node constructors ------------------------------------------------------
def mk_pat(kind, ln, col) -> list {
    return ["P", kind, [], [], "", [], "", false, [], "", ln, col];
}
def mk_ex_leaf(exname, text, flavor, ln, col) -> list {
    return ["E", exname, text, flavor, ln, col];
}
def mk_ex_bin(op, l, r, ln, col) -> list {
    return ["E", "Binary", op, [l, r], ln, col];
}
def mk_ex_unary(op, rhs, ln, col) -> list {
    return ["E", "Unary", op, rhs, ln, col];
}
def lit_from_token(t) -> list {
    k = t[0];
    if k == K_INT { return mk_ex_leaf("Int", t[1], "", t[2], t[3]); }
    if k == K_FLOAT { return mk_ex_leaf("Float", t[1], "", t[2], t[3]); }
    if k == K_CHAR { return mk_ex_leaf("Char", t[1], "", t[2], t[3]); }
    if k == K_STR or k == K_STRRAW or k == K_STRBYT or k == K_STRC {
        fl = "";
        if k == K_STRRAW { fl = " r"; }
        if k == K_STRBYT { fl = " b"; }
        if k == K_STRC { fl = " c"; }
        return mk_ex_leaf("Str", t[1], fl, t[2], t[3]);
    }
    return mk_ex_leaf("Ident", t[1], "", t[2], t[3]);
}

# types: ["T", NAME, ...]. typeStr renders inline.
def ty_name(n, gens) -> list { return ["T", "Name", n, gens]; }
def ty_pointer(inner) -> list { return ["T", "Pointer", inner]; }
def ty_ref(inner, mut: bool) -> list { return ["T", "Ref", inner, mut]; }
def ty_optional(inner) -> list { return ["T", "Optional", inner]; }
def ty_fn(params, ret) -> list { return ["T", "Fn", params, ret]; }
def ty_tuple(params) -> list { return ["T", "Tuple", params]; }

def ty_name_str(n, gens) -> string {
    out = n;
    if len(gens) > 0 {
        out = out + "[";
        for i in range(len(gens)) {
            if i > 0 { out = out + ", "; }
            out = out + type_str(gens[i]);
        }
        out = out + "]";
    }
    return out;
}
def type_str(t) -> string {
    if t == [] { return "<inferred>"; }
    if t[0] != "T" { return "<inferred>"; }
    if t[1] == "Name" { return ty_name_str(t[2], t[3]); }
    if t[1] == "Pointer" { return "*" + type_str(t[2]); }
    if t[1] == "Ref" {
        var out = "&";
        if t[3] { out = out + "mut "; }
        return out + type_str(t[2]);
    }
    if t[1] == "Optional" { return type_str(t[2]) + "?"; }
    if t[1] == "Fn" {
        var out = "fn(";
        ps = t[2];
        for i in range(len(ps)) {
            if i > 0 { out = out + ", "; }
            out = out + type_str(ps[i]);
        }
        out = out + ")";
        if t[3] != [] { out = out + " -> " + type_str(t[3]); }
        return out;
    }
    if t[1] == "Tuple" {
        var out = "(";
        ps = t[2];
        for i in range(len(ps)) {
            if i > 0 { out = out + ", "; }
            out = out + type_str(ps[i]);
        }
        out = out + ")";
        return out;
    }
    return "";
}

# ---- string helpers ---------------------------------------------------------
def q(s) -> string {
    out = "\"";
    for ch in s {
        c = ord(ch);
        if c == 10 { out = out + "\\n"; }
        elif c == 9 { out = out + "\\t"; }
        elif c == 92 { out = out + "\\\\"; }
        elif c == 34 { out = out + "\\\""; }
        else { out = out + str(ch); }
    }
    return out + "\"";
}
def ind(n: int) -> string {
    out = "";
    for i in range(n) { out = out + "  "; }
    return out;
}

# ---- AST dump buffer (mirrors src/ast/ast_dump.cpp) -------------------------
var out_buffer = [];
def emit(line) { out_buffer.append(line); }

def ex_name(k) -> string {
    names = ["Int", "Float", "Char", "Str", "FString", "Ident", "Unary", "Binary",
             "Call", "Index", "Slice", "Member", "Try", "Lambda", "Cond", "ListComp",
             "Generator", "List", "Dict", "Set", "Tuple", "New", "Cast"];
    for n in names {
        if k == n { return n; }
    }
    return "?";
}
def child_expr(label, e, d) {
    if e == [] { return; }
    if e[0] == "E" and (e[1] == "Int" or e[1] == "Float" or e[1] == "Char" or
                        e[1] == "Str" or e[1] == "Ident") {
        emit(ind(d) + label + " " + ex_name(e[1]) + " " + q(e[2]) + e[3]);
    } else {
        emit(ind(d) + label);
        dump_expr(e, d + 1);
    }
}
def dump_fpart(part, d) {
    if not part[1] {
        emit(ind(d) + "Text " + q(part[2]));
    } else {
        spec = part[4];
        emit(ind(d) + "Interp" + (if spec == "" { "" } else { " spec=" + spec }));
        child_expr("Value", part[2], d + 1);
    }
}
def dump_clause(c, d) {
    if c[1] {
        emit(ind(d) + "For");
        if c[2] != [] { dump_pat(c[2], d + 1); }
        child_expr("Iter", c[3], d);
    } elif c[4] != [] {
        emit(ind(d) + "Guard");
        child_expr("Cond", c[4], d + 1);
    }
}
def dump_expr(e, d) {
    k = e[1];
    if k == "Int" or k == "Float" or k == "Char" or k == "Str" or k == "Ident" {
        emit(ind(d) + ex_name(k) + " " + q(e[2]) + e[3]);
        return;
    }
    if k == "FString" {
        emit(ind(d) + "FString");
        for pp in e[6] { dump_fpart(pp, d + 1); }
        return;
    }
    if k == "Unary" {
        emit(ind(d) + "Unary op=" + q(e[2]));
        child_expr("Operand", e[3], d + 1);
        return;
    }
    if k == "Binary" {
        emit(ind(d) + "Binary op=" + q(e[2]));
        child_expr("Lhs", e[3][0], d + 1);
        child_expr("Rhs", e[3][1], d + 1);
        return;
    }
    if k == "Call" {
        emit(ind(d) + "Call");
        child_expr("Callee", e[3], d + 1);
        for a in e[6] {
            emit(ind(d + 1) + "Arg" + (if a[1] == "" { "" } else { " name=" + a[1] }));
            child_expr("Value", a[2], d + 2);
        }
        return;
    }
    if k == "New" {
        emit(ind(d) + "New type=" + type_str(e[7]));
        for a in e[6] {
            emit(ind(d + 1) + "Arg" + (if a[1] == "" { "" } else { " name=" + a[1] }));
            child_expr("Value", a[2], d + 2);
        }
        return;
    }
    if k == "Cast" {
        emit(ind(d) + "Cast as " + type_str(e[7]));
        child_expr("Operand", e[3], d + 1);
        return;
    }
    if k == "Index" {
        emit(ind(d) + "Index");
        child_expr("Obj", e[3][0], d + 1);
        child_expr("At", e[3], d + 1);
        return;
    }
    if k == "Slice" {
        emit(ind(d) + "Slice");
        child_expr("Obj", e[8][0], d + 1);
        labels = ["Lo", "Hi", "Step"];
        for i in range(3) {
            if len(e[8]) > i + 1 and e[8][i + 1] != [] {
                child_expr(labels[i], e[8][i + 1], d + 1);
            }
        }
        return;
    }
    if k == "Member" {
        emit(ind(d) + "Member name=" + q(e[7]) + (if e[5] { " nilsafe" } else { "" }));
        child_expr("Obj", e[3], d + 1);
        return;
    }
    if k == "Try" {
        emit(ind(d) + "Try '?'");
        child_expr("Operand", e[3], d + 1);
        return;
    }
    if k == "Lambda" {
        emit(ind(d) + "Lambda params=(");
        ps = e[2];
        # params are joined into one logical stream via ind(0)-prefixed pieces
        var line = ind(d) + "Lambda params=(";
        for i in range(len(ps)) {
            if i > 0 { line = line + ", "; }
            line = line + ps[i];
        }
        line = line + ")";
        emit(line);
        child_expr("Body", e[3], d + 1);
        return;
    }
    if k == "Cond" {
        emit(ind(d) + "Cond");
        child_expr("If", e[3], d + 1);
        child_expr("Then", e[4], d + 1);
        child_expr("Else", e[5], d + 1);
        return;
    }
    if k == "ListComp" or k == "Generator" {
        emit(ind(d) + ex_name(k));
        if len(e[4]) > 0 { child_expr("Element", e[4][0], d + 1); }
        for c in e[6] { dump_clause(c, d + 1); }
        return;
    }
    if k == "List" or k == "Set" or k == "Tuple" {
        emit(ind(d) + ex_name(k) + " len=" + str(len(e[4])));
        for el in e[4] { child_expr("Item", el, d + 1); }
        return;
    }
    if k == "Dict" {
        emit(ind(d) + "Dict len=" + str(len(e[5])));
        for pr in e[5] {
            emit(ind(d + 1) + "Pair");
            child_expr("Key", pr[0], d + 2);
            child_expr("Val", pr[1], d + 2);
        }
        return;
    }
}
def dump_pat(p, d) {
    k = p[1];
    if k == "Wild" {
        emit(ind(d) + "PatWild");
        return;
    }
    if k == "Literal" {
        emit(ind(d) + "PatLiteral");
        child_expr("Value", p[8], d + 1);
        return;
    }
    if k == "Range" {
        emit(ind(d) + "PatRange " + (if p[5] { "..=" } else { ".." }));
        if p[7] != [] { child_expr("Lo", p[7][8], d + 1); }
        if p[9] != [] { child_expr("Hi", p[9][8], d + 1); }
        return;
    }
    if k == "Tuple" {
        emit(ind(d) + "PatTuple len=" + str(len(p[3])));
        for el in p[3] { dump_pat(el, d + 1); }
        return;
    }
    if k == "Ctor" {
        emit(ind(d) + "PatCtor " + p[4]);
        for f in p[2] {
            emit(ind(d + 1) + "Field" + (if f[1] == "" { "" } else { " name=" + f[1] }));
            dump_pat(f[2], d + 2);
        }
        return;
    }
    if k == "Bind" {
        s = ind(d) + "PatBind " + p[4];
        if p[5] != [] { s = s + " : " + type_str(p[5]); }
        emit(s);
        return;
    }
}

def dump_stmt(s, d) {
    k = s[1];
    if k == "func" {
        buf = ind(d) + "FuncDef " + q(s[2]) + (if s[3] { " pub" } else { "" }) +
              (if s[4] { " extern" } else { "" });
        tp = s[9];
        if len(tp) > 0 {
            buf = buf + " generics=[";
            for i in range(len(tp)) {
                if i > 0 { buf = buf + ", "; }
                buf = buf + tp[i][0];
                if tp[i][1] != [] { buf = buf + " is " + type_str(tp[i][1]); }
            }
            buf = buf + "]";
        }
        emit(buf);
        for pp in s[5] {
            var head = ind(d + 1) + "Param " + q(pp[1]);
            if pp[4] { head = head + " self"; }
            if pp[3] { head = head + " variadic"; }
            if pp[2] { head = head + " mut"; }
            head = head + " : " + type_str(pp[5]);
            emit(head);
            child_expr("Default", pp[6], d + 2);
        }
        if s[6] != [] { emit(ind(d + 1) + "Ret " + type_str(s[6])); }
        emit(ind(d + 1) + "Body");
        for st in s[7] { dump_stmt(st, d + 2); }
        return;
    }
    if k == "struct" {
        emit(ind(d) + "StructDef " + q(s[2]) + (if s[3] { " pub" } else { "" }));
        for f in s[4] {
            if f[0] == "field" {
                buf = ind(d + 1) + "Field " + q(f[4]) + (if f[3] { " pub" } else { "" }) +
                      (if f[2] { " var" } else { "" }) + (if f[1] { " weak" } else { "" }) +
                      " : " + type_str(f[5]);
                emit(buf);
                child_expr("Default", f[6], d + 2);
            } else {
                dump_stmt(f, d + 1);
            }
        }
        return;
    }
    if k == "enum" {
        emit(ind(d) + "EnumDef " + q(s[2]) + (if s[3] { " pub" } else { "" }));
        for v in s[4] {
            out = ind(d + 1) + "Variant " + v[1];
            if len(v[2]) > 0 {
                out = out + " {";
                for i in range(len(v[2])) {
                    if i > 0 { out = out + ", "; }
                    out = out + v[2][i][1] + ": " + type_str(v[2][i][2]);
                }
                out = out + "}";
            }
            emit(out);
        }
        return;
    }
    if k == "trait" {
        emit(ind(d) + "TraitDef " + q(s[2]) + (if s[3] { " pub" } else { "" }));
        for sig in s[4] {
            var out = ind(d + 1) + "Sig " + sig[1] + "(";
            for i in range(len(sig[2])) {
                if i > 0 { out = out + ", "; }
                out = out + sig[2][i][1] + ": " + type_str(sig[2][i][5]);
            }
            out = out + ")";
            if sig[3] != [] { out = out + " -> " + type_str(sig[3]); }
            emit(out);
        }
        for m in s[5] { dump_stmt(m, d + 1); }
        return;
    }
    if k == "impl" {
        emit(ind(d) + "ImplDef " + type_str(s[1]) + " for " + type_str(s[2]));
        for m in s[3] { dump_stmt(m, d + 1); }
        return;
    }
    if k == "const" {
        emit(ind(d) + "ConstDecl");
        child_expr("Target", s[1], d + 1);
        if s[2] != [] { emit(ind(d + 1) + "Type " + type_str(s[2])); }
        child_expr("Value", s[3], d + 1);
        return;
    }
    if k == "VarDecl" {
        emit(ind(d) + "VarDecl" + (if s[6] == [] { "" } else { " : " + type_str(s[6]) }));
        child_expr("Target", s[5], d + 1);
        child_expr("Value", s[7], d + 1);
        return;
    }
    if k == "Pass" { emit(ind(d) + "Pass"); return; }
    if k == "ExprStmt" {
        emit(ind(d) + "ExprStmt");
        if len(s[4]) > 0 { child_expr("Value", s[4][0], d + 1); }
        return;
    }
    if k == "Assign" {
        emit(ind(d) + "Assign");
        n = len(s[4]);
        paired = n >= 2 and n % 2 == 0;
        half = if paired { n // 2 } else { 0 };
        for i in range(n) {
            e = s[4][i];
            if e == [] { continue; }
            if paired {
                child_expr(if i < half { "Target" } else { "Value" }, e, d + 1);
            } else {
                child_expr("Expr", e, d + 1);
            }
        }
        return;
    }
    if k == "AugAssign" {
        emit(ind(d) + "AugAssign op=" + q(s[3]));
        child_expr("Target", s[4][0], d + 1);
        child_expr("Value", s[4][1], d + 1);
        return;
    }
    if k == "Return" or k == "Raise" or k == "Defer" or k == "Spawn" {
        emit(ind(d) + k);
        for e in s[4] {
            child_expr(if k == "Defer" or k == "Spawn" { "Call" } else { "Value" }, e, d + 1);
        }
        return;
    }
    if k == "Break" or k == "Continue" {
        emit(ind(d) + k);
        return;
    }
    if k == "If" {
        emit(ind(d) + "If");
        child_expr("Cond", s[4][0], d + 1);
        emit(ind(d + 1) + "Then");
        for st in s[5] { dump_stmt(st, d + 2); }
        if len(s[6]) == 1 and s[6][0] != [] and s[6][0][1] == "if" and
           len(s[6][0][5]) > 0 {
            dump_stmt(s[6][0], d);
            return;
        }
        if len(s[6]) > 0 {
            emit(ind(d + 1) + "Else");
            for st in s[6] { dump_stmt(st, d + 2); }
        }
        return;
    }
    if k == "While" {
        emit(ind(d) + "While");
        child_expr("Cond", s[4][0], d + 1);
        emit(ind(d + 1) + "Body");
        for st in s[5] { dump_stmt(st, d + 2); }
        return;
    }
    if k == "For" {
        emit(ind(d) + "For");
        dump_pat(s[7], d + 1);
        child_expr("Iter", s[4][0], d + 1);
        emit(ind(d + 1) + "Body");
        for st in s[5] { dump_stmt(st, d + 2); }
        return;
    }
    if k == "Match" {
        emit(ind(d) + "Match");
        child_expr("Subject", s[4][0], d + 1);
        for arm in s[8] {
            emit(ind(d + 1) + "Arm");
            dump_pat(arm[1], d + 2);
            child_expr("Guard", arm[2], d + 2);
            emit(ind(d + 2) + "Body");
            for st in arm[3] { dump_stmt(st, d + 3); }
        }
        return;
    }
    if k == "Select" {
        emit(ind(d) + "Select");
        for arm in s[9] {
            emit(ind(d + 1) + "SelArm" + (if arm[1] == "" { "" } else { " bind=" + arm[1] }));
            child_expr("ChanOp", arm[2], d + 2);
            emit(ind(d + 2) + "Body");
            for st in arm[3] { dump_stmt(st, d + 3); }
        }
        return;
    }
    if k == "Unsafe" {
        emit(ind(d) + "Unsafe");
        for st in s[5] { dump_stmt(st, d + 1); }
        return;
    }
    if k == "import" {
        buf = ind(d) + (if s[5] { "FromImport " } else { "Import " }) + s[1];
        if s[3] { buf = buf + " *"; }
        if s[4] != "" { buf = buf + " as " + s[4]; }
        if len(s[2]) > 0 {
            buf = buf + " items=[";
            for i in range(len(s[2])) {
                if i > 0 { buf = buf + ", "; }
                buf = buf + s[2][i][1];
                if s[2][i][2] != "" { buf = buf + " as " + s[2][i][2]; }
            }
            buf = buf + "]";
        }
        emit(buf);
        return;
    }
}

# ---- program dispatch -------------------------------------------------------
def parse_try_top(p) -> list {
    outcome = catch_panic(() => parse_top_or_stmt(p));
    match outcome {
        case ok(v) { return v; }
        case err(msg) { psync_to_statement_end(p); return []; }
    }
    return [];
}
def parse_program(p) -> list {
    out = [];
    pskip_newlines(p);
    while not pat(p, K_EOF) {
        if patPunct(p, "}") {
            padv(p);
            continue;
        }
        s = parse_try_top(p);
        if s != [] { out.append(s); }
        pskip_newlines(p);
    }
    return out;
}

def parse_top_or_stmt(p) -> list {
    if pcur(p)[0] == K_IDENT and patPunct(p, ":", 1) and
       (patIdent(p, "while", 2) or patIdent(p, "for", 2)) {
        lbl = padv(p)[1];
        padv(p);
        s = parse_compound(p);
        s[4] = lbl;
        return s;
    }
    if patIdent(p, "def") { return parse_func_def(p, false); }
    if patIdent(p, "pub") {
        padv(p);
        if patIdent(p, "def") { return parse_func_def(p, true); }
        if patIdent(p, "struct") {
            s = parse_struct_def(p);
            s[3] = true;
            return s;
        }
        if patIdent(p, "enum") {
            s = parse_enum_def(p);
            s[3] = true;
            return s;
        }
        if patIdent(p, "trait") {
            s = parse_trait_def(p);
            s[3] = true;
            return s;
        }
        if patIdent(p, "const") {
            padv(p);
            s = finish_const_decl(p);
            s[4] = true;
            return s;
        }
        c = pcur(p);
        preport(p, c[2], c[3], "'pub' must precede def/struct/enum/trait/const");
        perr(p, "pub");
    }
    if patIdent(p, "extern") and patIdent(p, "def", 1) {
        padv(p);
        s = parse_func_def(p, false, false);
        s[4] = true;
        pexpect_punct(p, ";");
        return s;
    }
    if patIdent(p, "struct") { return parse_struct_def(p); }
    if patIdent(p, "enum") { return parse_enum_def(p); }
    if patIdent(p, "trait") { return parse_trait_def(p); }
    if patIdent(p, "impl") { return parse_impl_def(p); }
    if patIdent(p, "import") or patIdent(p, "from") {
        return parse_import(p, patIdent(p, "from"), false);
    }
    if patIdent(p, "export") { return parse_import(p, false, true); }
    if patIdent(p, "const") { padv(p); return finish_const_decl(p); }
    if patIdent(p, "if") or patIdent(p, "while") or patIdent(p, "for") or
       patIdent(p, "match") or patIdent(p, "select") or patIdent(p, "unsafe") {
        return parse_compound(p);
    }
    return parse_simple(p);
}

# ---- types ------------------------------------------------------------------
def parse_type_params(p) -> list {
    out = [];
    pexpect_punct(p, "[");
    while not patPunct(p, "]") {
        name_tok = pexpect(p, K_IDENT, "type parameter name");
        bound = [];
        if patIdent(p, "is") { padv(p); bound = parse_type(p); }
        out.append([name_tok[1], bound]);
        if patPunct(p, ",") { padv(p); } else { break; }
    }
    pexpect_punct(p, "]");
    return out;
}
def parse_param_list(p) -> list {
    out = [];
    pexpect_punct(p, "(");
    while not patPunct(p, ")") {
        if patPunct(p, ",") { padv(p); continue; }
        if (pcur(p)[0] == K_OP and pcur(p)[1] == "..") or
           (pcur(p)[0] == K_PUNCT and pcur(p)[1] == ".") {
            while (pcur(p)[0] == K_OP or pcur(p)[0] == K_PUNCT) and
                  (pcur(p)[1] == ".." or pcur(p)[1] == ".") {
                padv(p);
            }
            pp = ["param", "", false, true, false, [], [], pcur(p)[2], pcur(p)[3]];
            out.append(pp);
            break;
        }
        pp = ["param", "", false, false, false, [], [], pcur(p)[2], pcur(p)[3]];
        if patIdent(p, "self") {
            padv(p);
            pp[4] = true;
            pp[1] = "self";
            if patPunct(p, ":") { padv(p); pp[5] = parse_type(p); }
        } elif patOp(p, "*") {
            padv(p);
            pp[3] = true;
            pp[1] = pexpect(p, K_IDENT, "parameter name")[1];
            if patPunct(p, ":") { padv(p); pp[5] = parse_type(p); }
        } else {
            if patIdent(p, "var") and pcur(p, 1)[0] == K_IDENT and
               not is_kw(pcur(p, 1)[1]) {
                padv(p);
                pp[2] = true;
            }
            pp[1] = pexpect(p, K_IDENT, "parameter name")[1];
            if patPunct(p, ":") { padv(p); pp[5] = parse_type(p); }
            if patOp(p, "=") { padv(p); pp[6] = parse_expr(p); }
        }
        out.append(pp);
        if patPunct(p, ",") { padv(p); } else { break; }
    }
    pexpect_punct(p, ")");
    return out;
}

# ---- declarations -----------------------------------------------------------
def parse_func_def(p, is_pub: bool, allow_body: bool = true) -> list {
    padv(p);
    name_tok = pexpect(p, K_IDENT, "function name");
    s = ["func", name_tok[1], is_pub, false, false, [], [], [], [], [], name_tok[2], name_tok[3]];
    if patPunct(p, "[") { s[5] = parse_type_params(p); }
    s[6] = parse_param_list(p);
    if patOp(p, "->") { padv(p); s[7] = parse_type(p); }
    if allow_body {
        s[8] = parse_block(p);
        pend_block(p);
    }
    return s;
}
def parse_struct_def(p) -> list {
    padv(p);
    name_tok = pexpect(p, K_IDENT, "struct name");
    s = ["struct", name_tok[1], false, false, [], [], name_tok[2], name_tok[3]];
    if patPunct(p, "[") { s[4] = parse_type_params(p); }
    pexpect_punct(p, "{");
    while true {
        if patPunct(p, "}") { padv(p); break; }
        if pat(p, K_EOF) {
            c = pcur(p);
            preport(p, c[2], c[3], "unexpected end of file inside struct body");
            perr(p, "structeof");
        }
        if patIdent(p, "def") {
            s[5].append(parse_func_def(p, false));
            continue;
        }
        f = ["field", false, false, false, "", [], [], pcur(p)[2], pcur(p)[3]];
        if patIdent(p, "weak") { padv(p); f[1] = true; }
        if patIdent(p, "var") and pcur(p, 1)[0] == K_IDENT and
           not is_kw(pcur(p, 1)[1]) {
            padv(p);
            f[2] = true;
        }
        if patIdent(p, "pub") { padv(p); f[3] = true; }
        f[4] = pexpect(p, K_IDENT, "field name")[1];
        pexpect_punct(p, ":");
        f[5] = parse_type(p);
        if patOp(p, "=") { padv(p); f[6] = parse_expr(p); }
        pexpect_punct(p, ";");
        s[5].append(f);
    }
    return s;
}
def parse_variants(p) -> list {
    out = [];
    while true {
        if patPunct(p, "}") or pat(p, K_EOF) { break; }
        if patPunct(p, ",") { padv(p); continue; }
        v = ["variant", "", [], pcur(p)[2], pcur(p)[3]];
        v[1] = pexpect(p, K_IDENT, "variant name")[1];
        if patPunct(p, "(") {
            padv(p);
            while not patPunct(p, ")") {
                if patPunct(p, ",") { padv(p); continue; }
                pl = ["vpay", "", []];
                pl[1] = pexpect(p, K_IDENT, "payload name")[1];
                pexpect_punct(p, ":");
                pl[2] = parse_type(p);
                v[2].append(pl);
                if patPunct(p, ",") { padv(p); } else { break; }
            }
            pexpect_punct(p, ")");
        }
        out.append(v);
    }
    return out;
}
def parse_enum_def(p) -> list {
    padv(p);
    name_tok = pexpect(p, K_IDENT, "enum name");
    s = ["enum", name_tok[1], false, false, [], [], name_tok[2], name_tok[3]];
    if patPunct(p, "[") { s[4] = parse_type_params(p); }
    pexpect_punct(p, "{");
    s[5] = parse_variants(p);
    pexpect_punct(p, "}");
    return s;
}
def parse_trait_def(p) -> list {
    padv(p);
    name_tok = pexpect(p, K_IDENT, "trait name");
    s = ["trait", name_tok[1], false, false, [], [], [], name_tok[2], name_tok[3]];
    if patPunct(p, "[") { s[4] = parse_type_params(p); }
    pexpect_punct(p, "{");
    while true {
        if patPunct(p, "}") { padv(p); break; }
        if pat(p, K_EOF) {
            c = pcur(p);
            preport(p, c[2], c[3], "unexpected end of file inside trait body");
            perr(p, "traiteof");
        }
        start_idx = p["idx"];
        pexpect(p, K_IDENT, "'def'");
        name_tok = pexpect(p, K_IDENT, "method name");
        has_body = false;
        j = p["idx"];
        depth = 0;
        while true {
            if j >= len(p["toks"]) { break; }
            t = p["toks"][j];
            if t[0] == K_EOF { break; }
            if t[0] == K_PUNCT {
                if t[1] == "(" or t[1] == "[" { depth = depth + 1; }
                elif t[1] == ")" or t[1] == "]" { depth = depth - 1; }
                elif depth == 0 and t[1] == "{" { has_body = true; break; }
                elif depth == 0 and t[1] == ";" { break; }
            }
            j = j + 1;
        }
        if has_body {
            p["idx"] = start_idx;
            s[6].append(parse_func_def(p, false));
        } else {
            if patPunct(p, "[") { parse_type_params(p); }
            params = parse_param_list(p);
            ret = [];
            if patOp(p, "->") { padv(p); ret = parse_type(p); }
            sig = ["tsig", name_tok[1], params, ret, name_tok[2], name_tok[3]];
            s[5].append(sig);
            pexpect_punct(p, ";");
        }
    }
    return s;
}
def parse_impl_def(p) -> list {
    padv(p);
    s = ["impl", [], [], [], pcur(p)[2], pcur(p)[3]];
    if patPunct(p, "[") { parse_type_params(p); }
    s[1] = parse_type(p);
    if not patIdent(p, "for") {
        c = pcur(p);
        preport(p, c[2], c[3], "expected 'for' in impl header");
        perr(p, "implfor");
    }
    padv(p);
    s[2] = parse_type(p);
    s[3] = parse_block(p);
    pend_block(p);
    return s;
}
def finish_const_decl(p) -> list {
    id_tok = pexpect(p, K_IDENT, "constant name");
    target = mk_ex_leaf("Ident", id_tok[1], "", id_tok[2], id_tok[3]);
    s = ["const", target, [], [], false, pcur(p)[2], pcur(p)[3]];
    if patPunct(p, ":") { padv(p); s[2] = parse_type(p); }
    pexpect_op(p, "=");
    s[3] = parse_expr(p);
    pexpect_punct(p, ";");
    return s;
}
def dotted_name(p) -> string {
    c = pcur(p);
    mod = "";
    if c[0] == K_STR or c[0] == K_STRRAW {
        mod = padv(p)[1];
        return mod;
    }
    while true {
        if pcur(p)[0] == K_IDENT and not patIdent(p, "as") and not patIdent(p, "import") {
            mod = mod + padv(p)[1];
        } elif patPunct(p, ".") {
            mod = mod + padv(p)[1];
        } elif patPunct(p, "/") {
            mod = mod + padv(p)[1];
        } else {
            break;
        }
    }
    return mod;
}
def parse_import(p, from_kw: bool, export_kw: bool) -> list {
    s = ["import", "", [], false, "", false, pcur(p)[2], pcur(p)[3]];
    if export_kw { padv(p); }
    if patIdent(p, "from") {
        padv(p);
        s[5] = true;
        s[1] = dotted_name(p);
        if not patIdent(p, "import") {
            c = pcur(p);
            preport(p, c[2], c[3], "expected 'import' in from-import");
            perr(p, "fromimp");
        }
        padv(p);
        if patOp(p, "*") {
            padv(p);
            s[3] = true;
            pexpect_punct(p, ";");
            return s;
        }
        while true {
            n = pexpect(p, K_IDENT, "imported name");
            it = ["iitem", n[1], ""];
            if patIdent(p, "as") {
                padv(p);
                it[2] = pexpect(p, K_IDENT, "alias")[1];
            }
            s[2].append(it);
            if patPunct(p, ",") { padv(p); continue; }
            break;
        }
        pexpect_punct(p, ";");
        return s;
    }
    pexpect(p, K_IDENT, "'import'");
    s[1] = dotted_name(p);
    if patIdent(p, "as") {
        padv(p);
        s[4] = pexpect(p, K_IDENT, "alias")[1];
    }
    pexpect_punct(p, ";");
    return s;
}

# ---- blocks & compound ------------------------------------------------------
def parse_block(p) -> list {
    pexpect_punct(p, "{");
    body = [];
    while true {
        if patPunct(p, "}") { break; }
        if pat(p, K_EOF) {
            c = pcur(p);
            preport(p, c[2], c[3], "unexpected end of file inside block (missing '}')");
            perr(p, "blockeof");
        }
        b = parse_try_top(p);
        if b != [] { body.append(b); }
    }
    return body;
}
def pend_block(p) {
    if patPunct(p, "}") { padv(p); }
}
def parse_if_chain(p) -> list {
    s = ["S", "if", "", pcur(p)[2], pcur(p)[3]];
    padv(p);
    s[4] = [parse_expr(p)];
    s[5] = parse_block(p);
    pend_block(p);
    if patIdent(p, "elif") or patIdent(p, "else") {
        if patIdent(p, "elif") {
            s[6].append(parse_if_chain(p));
            return s;
        }
        padv(p);
        if patIdent(p, "if") {
            s[6].append(parse_if_chain(p));
            return s;
        }
        s[6] = parse_block(p);
        pend_block(p);
    }
    return s;
}
def parse_compound(p) -> list {
    if patIdent(p, "if") { return parse_if_chain(p); }
    if patIdent(p, "while") {
        s = ["S", "While", "", pcur(p)[2], pcur(p)[3]];
        padv(p);
        s[4] = [parse_expr(p)];
        s[5] = parse_block(p);
        pend_block(p);
        return s;
    }
    if patIdent(p, "for") {
        s = ["S", "For", "", pcur(p)[2], pcur(p)[3]];
        padv(p);
        s[7] = parse_pattern(p);
        if not patIdent(p, "in") {
            c = pcur(p);
            preport(p, c[2], c[3], "expected 'in' in for loop");
            perr(p, "forin");
        }
        padv(p);
        s[4] = [parse_expr(p)];
        s[5] = parse_block(p);
        pend_block(p);
        return s;
    }
    if patIdent(p, "match") {
        s = ["S", "Match", "", pcur(p)[2], pcur(p)[3]];
        padv(p);
        s[4] = [parse_expr(p)];
        pexpect_punct(p, "{");
        while true {
            if patPunct(p, "}") or pat(p, K_EOF) { break; }
            pexpect(p, K_IDENT, "'case'");
            arm = ["arm", [], [], []];
            arm[1] = parse_pattern(p);
            if patIdent(p, "if") { padv(p); arm[2] = parse_expr(p); }
            arm[3] = parse_block(p);
            pend_block(p);
            s[8].append(arm);
        }
        pend_block(p);
        return s;
    }
    if patIdent(p, "select") {
        s = ["S", "Select", "", pcur(p)[2], pcur(p)[3]];
        padv(p);
        pexpect_punct(p, "{");
        while true {
            if patPunct(p, "}") or pat(p, K_EOF) { break; }
            pexpect(p, K_IDENT, "'case'");
            arm = ["selarm", "", [], []];
            if pcur(p)[0] == K_IDENT and patOp(p, "=", 1) {
                arm[1] = padv(p)[1];
                padv(p);
            }
            if patOp(p, "<-") {
                padv(p);
                arm[2] = parse_expr(p);
            } else {
                arm[2] = parse_expr(p);
            }
            arm[3] = parse_block(p);
            pend_block(p);
            s[9].append(arm);
        }
        pend_block(p);
        return s;
    }
    if patIdent(p, "unsafe") {
        s = ["S", "Unsafe", "", pcur(p)[2], pcur(p)[3]];
        padv(p);
        s[5] = parse_block(p);
        pend_block(p);
        return s;
    }
    c = pcur(p);
    preport(p, c[2], c[3], "internal: unknown compound statement");
    perr(p, "compound");
    return [];
}

# ---- simple statements ------------------------------------------------------
def parse_simple(p) -> list {
    s = parse_simple_stmt(p);
    pexpect_punct(p, ";");
    return s;
}
def parse_simple_stmt(p) -> list {
    s = ["SS", "", "", pcur(p)[2], pcur(p)[3]];
    if pcur(p)[0] == K_IDENT {
        w = pcur(p)[1];
        if w == "pass" {
            padv(p);
            s[1] = "Pass";
            return s;
        }
        if w == "return" {
            padv(p);
            s[1] = "Return";
            if not patPunct(p, ";") and not pat(p, K_EOF) {
                s[4].append(parse_expr(p));
                while patPunct(p, ",") {
                    padv(p);
                    s[4].append(parse_expr(p));
                }
            }
            return s;
        }
        if w == "raise" {
            padv(p);
            s[1] = "Raise";
            s[4].append(parse_expr(p));
            return s;
        }
        if w == "break" {
            padv(p);
            s[1] = "Break";
            if pcur(p)[0] == K_IDENT { s[2] = padv(p)[1]; }
            return s;
        }
        if w == "continue" {
            padv(p);
            s[1] = "Continue";
            if pcur(p)[0] == K_IDENT { s[2] = padv(p)[1]; }
            return s;
        }
        if w == "defer" {
            padv(p);
            s[1] = "Defer";
            s[4].append(parse_expr(p));
            return s;
        }
        if w == "spawn" {
            padv(p);
            s[1] = "Spawn";
            s[4].append(parse_expr(p));
            return s;
        }
        if w == "var" and pcur(p, 1)[0] == K_IDENT and not is_kw(pcur(p, 1)[1]) {
            padv(p);
            s[1] = "VarDecl";
            s[8] = true;
            s[5] = parse_expr(p);
            if patPunct(p, ":") { padv(p); s[6] = parse_type(p); }
            if patOp(p, "=") { padv(p); s[7] = parse_expr(p); }
            return s;
        }
    }
    first = parse_expr(p);
    if first[0] == "E" and first[1] == "Ident" and patPunct(p, ":") {
        s[1] = "VarDecl";
        s[5] = first;
        padv(p);
        s[6] = parse_type(p);
        pexpect_op(p, "=");
        s[7] = parse_expr(p);
        return s;
    }
    targets = [first];
    while patPunct(p, ",") {
        padv(p);
        targets.append(parse_expr(p));
    }
    if patOp(p, "=") {
        s[1] = "Assign";
        for t in targets { s[4].append(t); }
        padv(p);
        s[4].append(parse_expr(p));
        while patPunct(p, ",") {
            padv(p);
            s[4].append(parse_expr(p));
        }
        return s;
    }
    if len(targets) == 1 {
        if pcur(p)[0] == K_OP and is_aug_op(pcur(p)[1]) {
            s[1] = "AugAssign";
            s[3] = padv(p)[1];
            s[4].append(targets[0]);
            s[4].append(parse_expr(p));
            return s;
        }
        s[1] = "ExprStmt";
        s[4].append(targets[0]);
        return s;
    }
    c = pcur(p);
    preport(p, c[2], c[3], "expected '=' after comma-separated targets");
    perr(p, "assignlist");
    return [];
}

# ---- patterns ---------------------------------------------------------------
def parse_pattern(p) -> list {
    first = parse_ctor_or_bind(p);
    if not patOp(p, "|") { return first; }
    orp = mk_pat("Or", first[2], first[3]);
    orp[2] = [first];
    while patOp(p, "|") {
        padv(p);
        orp[2].append(parse_ctor_or_bind(p));
    }
    return orp;
}
def parse_ctor_or_bind(p) -> list {
    sp_l = pcur(p)[2];
    sp_c = pcur(p)[3];
    if pcur(p)[0] == K_IDENT and pcur(p)[1] == "_" {
        padv(p);
        return mk_pat("Wild", sp_l, sp_c);
    }
    if patPunct(p, "[") {
        padv(p);
        sl = mk_pat("Slice", sp_l, sp_c);
        while not patPunct(p, "]") {
            if patPunct(p, ",") { padv(p); continue; }
            if patOp(p, "..") {
                padv(p);
                if pcur(p)[0] == K_IDENT and pcur(p)[1] != "_" {
                    sl[6] = padv(p)[1];
                }
                break;
            }
            sl[3].append(parse_pattern(p));
            if patPunct(p, ",") { padv(p); } else { break; }
        }
        pexpect_punct(p, "]");
        return sl;
    }
    if patPunct(p, "(") {
        padv(p);
        if patPunct(p, ")") {
            padv(p);
            return mk_pat("Tuple", sp_l, sp_c);
        }
        if patOp(p, "..") {
            padv(p);
            tup = mk_pat("Tuple", sp_l, sp_c);
            if pcur(p)[0] == K_IDENT and pcur(p)[1] != "_" {
                tup[6] = padv(p)[1];
            }
            if not patPunct(p, ")") {
                while patPunct(p, ",") {
                    padv(p);
                    if patPunct(p, ")") { break; }
                    tup[3].append(parse_pattern(p));
                    if patPunct(p, ",") { padv(p); } else { break; }
                }
            }
            pexpect_punct(p, ")");
            return tup;
        }
        first = parse_pattern(p);
        if patPunct(p, ",") {
            tup = mk_pat("Tuple", sp_l, sp_c);
            tup[3].append(first);
            while patPunct(p, ",") {
                padv(p);
                if patPunct(p, ")") { break; }
                if patOp(p, "..") {
                    padv(p);
                    if pcur(p)[0] == K_IDENT and pcur(p)[1] != "_" {
                        tup[6] = padv(p)[1];
                    }
                    break;
                }
                tup[3].append(parse_pattern(p));
            }
            pexpect_punct(p, ")");
            return tup;
        }
        pexpect_punct(p, ")");
        return first;
    }
    minus = patOp(p, "-");
    tk = pcur(p);
    if minus or tk[0] == K_INT or tk[0] == K_FLOAT or tk[0] == K_CHAR or
       tk[0] == K_STR or tk[0] == K_STRRAW or
       (tk[0] == K_IDENT and (tk[1] == "true" or tk[1] == "false" or tk[1] == "none")) {
        lit = [];
        if minus {
            padv(p);
            if pcur(p)[0] == K_INT {
                lit = lit_from_token(pexpect(p, K_INT, "number"));
            } else {
                lit = lit_from_token(pexpect(p, K_FLOAT, "number"));
            }
            lit = mk_ex_unary("-", lit, sp_l, sp_c);
        } else {
            lit = lit_from_token(padv(p));
        }
        if patOp(p, "..") or patOp(p, "..=") {
            incl = pcur(p)[1] == "..=";
            padv(p);
            r = mk_pat("Range", sp_l, sp_c);
            r[7] = mk_pat("Literal", sp_l, sp_c);
            r[7][8] = lit;
            neg2 = patOp(p, "-");
            if neg2 { padv(p); }
            exp_kind = if pcur(p)[0] == K_FLOAT { K_FLOAT } else { K_INT };
            num = pexpect(p, exp_kind, "number");
            hi_lit = lit_from_token(num);
            if neg2 { hi_lit = mk_ex_unary("-", hi_lit, sp_l, sp_c); }
            r[9] = mk_pat("Literal", sp_l, sp_c);
            r[9][8] = hi_lit;
            r[5] = incl;
            return r;
        }
        pp = mk_pat("Literal", sp_l, sp_c);
        pp[8] = lit;
        return pp;
    }
    if pcur(p)[0] != K_IDENT {
        c = pcur(p);
        preport(p, c[2], c[3], "expected pattern, found '" + c[1] + "'");
        perr(p, "pattern");
    }
    if patPunct(p, "(", 1) {
        pp = mk_pat("Ctor", sp_l, sp_c);
        pp[4] = padv(p)[1];
        padv(p);
        while not patPunct(p, ")") {
            if patPunct(p, ",") { padv(p); continue; }
            fld = ["pfield", "", []];
            if pcur(p)[0] == K_IDENT and patPunct(p, ":", 1) {
                fld[1] = padv(p)[1];
                padv(p);
                fld[2] = parse_pattern(p);
            } else {
                fld[2] = parse_pattern(p);
            }
            pp[2].append(fld);
            if patPunct(p, ",") { padv(p); } else { break; }
        }
        pexpect_punct(p, ")");
        return pp;
    }
    pp = mk_pat("Bind", sp_l, sp_c);
    if patIdent(p, "var") and pcur(p, 1)[0] == K_IDENT { padv(p); }
    pp[4] = pexpect(p, K_IDENT, "binding name")[1];
    if patIdent(p, "is") { padv(p); pp[5] = parse_type(p); }
    if patOp(p, "@") {
        padv(p);
        alias = mk_pat("BindAlias", sp_l, sp_c);
        alias[4] = pp[4];
        alias[5] = pp[5];
        alias[6] = parse_pattern(p);
        return alias;
    }
    return pp;
}

# ---- types ------------------------------------------------------------------
def parse_base_type(p) -> list {
    sp_l = pcur(p)[2];
    sp_c = pcur(p)[3];
    if patIdent(p, "fn") {
        padv(p);
        ps = [];
        pexpect_punct(p, "(");
        while not patPunct(p, ")") {
            if patPunct(p, ",") { padv(p); continue; }
            ps.append(parse_type(p));
            if patPunct(p, ",") { padv(p); } else { break; }
        }
        pexpect_punct(p, ")");
        ret = [];
        if patOp(p, "->") { padv(p); ret = parse_type(p); }
        return ty_fn(ps, ret);
    }
    if pcur(p)[0] == K_IDENT {
        name_tok = padv(p);
        gens = [];
        if patPunct(p, "[") {
            padv(p);
            while not patPunct(p, "]") {
                if patPunct(p, ",") { padv(p); continue; }
                gens.append(parse_type(p));
                if patPunct(p, ",") { padv(p); } else { break; }
            }
            pexpect_punct(p, "]");
        }
        return ty_name(name_tok[1], gens);
    }
    if patPunct(p, "(") {
        padv(p);
        if patPunct(p, ")") {
            padv(p);
            return ty_name("none", []);
        }
        ts = [parse_type(p)];
        tuple = false;
        while patPunct(p, ",") {
            padv(p);
            tuple = true;
            if patPunct(p, ")") { break; }
            ts.append(parse_type(p));
        }
        pexpect_punct(p, ")");
        if not tuple { return ts[0]; }
        return ty_tuple(ts);
    }
    c = pcur(p);
    preport(p, c[2], c[3], "expected type, found '" + c[1] + "'");
    perr(p, "type");
    return [];
}
def parse_type(p) -> list {
    t = [];
    if patOp(p, "*") {
        padv(p);
        t = ty_pointer(parse_type(p));
    } elif patOp(p, "&") {
        padv(p);
        mut = patIdent(p, "mut") and pcur(p, 1)[0] == K_IDENT;
        if mut { padv(p); }
        t = ty_ref(parse_type(p), mut);
    } else {
        t = parse_base_type(p);
    }
    while patOp(p, "?") {
        padv(p);
        t = ty_optional(t);
    }
    return t;
}

# ---- expressions ------------------------------------------------------------
def try_parse_lambda(p) -> list {
    if not patPunct(p, "(") { return []; }
    j = p["idx"];
    depth = 0;
    ok_shape = true;
    while true {
        j = j + 1;
        if j >= len(p["toks"]) { return []; }
        t = p["toks"][j];
        if t[0] == K_EOF or t[0] == K_NEWLN { return []; }
        if t[0] == K_PUNCT {
            if t[1] == "(" { depth = depth + 1; continue; }
            if t[1] == ")" {
                depth = depth - 1;
                if depth == 0 { j = j + 1; break; }
                continue;
            }
            if depth == 1 and t[1] != "," { ok_shape = false; }
            continue;
        }
        if depth >= 1 and t[0] != K_IDENT { ok_shape = false; }
    }
    if not ok_shape { return []; }
    if j >= len(p["toks"]) or p["toks"][j][0] != K_OP or p["toks"][j][1] != "=>" {
        return [];
    }
    padv(p);
    lam = ["E", "Lambda", [], "", pcur(p)[2], pcur(p)[3]];
    while not patPunct(p, ")") {
        lam[2].append(pexpect(p, K_IDENT, "lambda parameter")[1]);
        if patPunct(p, ",") { padv(p); } else { break; }
    }
    pexpect_punct(p, ")");
    pexpect_op(p, "=>");
    lam[3] = parse_expr(p);
    return lam;
}
def parse_expr(p) -> list {
    sp_l = pcur(p)[2];
    sp_c = pcur(p)[3];
    if patIdent(p, "spawn") {
        e = mk_ex_unary("spawn", [], sp_l, sp_c);
        padv(p);
        e[3] = parse_expr(p);
        return e;
    }
    if patIdent(p, "for") {
        g = ["E", "Generator", [], [], [pcur(p)[2], pcur(p)[3]]];
        cl = ["clause", true, [], [], []];
        g[5] = [cl];
        padv(p);
        g[5][0][2] = parse_pattern(p);
        if not patIdent(p, "in") {
            c = pcur(p);
            preport(p, c[2], c[3], "expected 'in' in generator");
            perr(p, "genin");
        }
        padv(p);
        g[5][0][3] = parse_expr(p);
        while true {
            if patIdent(p, "for") {
                cl2 = ["clause", true, [], [], []];
                g[5].append(cl2);
                padv(p);
                g[5][len(g[5]) - 1][2] = parse_pattern(p);
                if not patIdent(p, "in") {
                    c = pcur(p);
                    preport(p, c[2], c[3], "expected 'in'");
                    perr(p, "genin");
                }
                padv(p);
                g[5][len(g[5]) - 1][3] = parse_expr(p);
            } elif patIdent(p, "if") {
                cl3 = ["clause", false, [], [], []];
                g[5].append(cl3);
                padv(p);
                g[5][len(g[5]) - 1][4] = parse_expr(p);
            } else {
                break;
            }
        }
        if not patIdent(p, "yield") {
            c = pcur(p);
            preport(p, c[2], c[3], "expected 'yield' in generator");
            perr(p, "genyield");
        }
        padv(p);
        g[4] = [parse_expr(p)];
        return g;
    }
    if patIdent(p, "if") { return parse_cond_expr(p); }
    lam = try_parse_lambda(p);
    if lam != [] { return lam; }
    return parse_or(p);
}
def parse_cond_expr(p) -> list {
    e = ["E", "Cond", "", "", "", pcur(p)[2], pcur(p)[3]];
    padv(p);
    e[3] = parse_expr(p);
    pexpect_punct(p, "{");
    e[4] = parse_expr(p);
    pexpect_punct(p, "}");
    if not patIdent(p, "else") {
        c = pcur(p);
        preport(p, c[2], c[3], "expected 'else { ... }' in conditional expression");
        perr(p, "condelse");
    }
    padv(p);
    pexpect_punct(p, "{");
    e[5] = parse_expr(p);
    pexpect_punct(p, "}");
    return e;
}
def parse_comp_expr(p, first) -> list {
    e = ["E", "ListComp", [], [], [pcur(p)[2], pcur(p)[3]]];
    e[4] = [first];
    while true {
        if patIdent(p, "for") {
            cl = ["clause", true, [], [], []];
            e[5].append(cl);
            padv(p);
            e[5][len(e[5]) - 1][2] = parse_pattern(p);
            if not patIdent(p, "in") {
                c = pcur(p);
                preport(p, c[2], c[3], "expected 'in' in comprehension");
                perr(p, "compin");
            }
            padv(p);
            e[5][len(e[5]) - 1][3] = parse_expr(p);
        } elif patIdent(p, "if") {
            cl2 = ["clause", false, [], [], []];
            e[5].append(cl2);
            padv(p);
            e[5][len(e[5]) - 1][4] = parse_expr(p);
        } else {
            break;
        }
    }
    return e;
}
def parse_or(p) -> list {
    l = parse_and(p);
    while patIdent(p, "or") {
        sp_l = pcur(p)[2]; sp_c = pcur(p)[3];
        padv(p);
        l = mk_ex_bin("or", l, parse_and(p), sp_l, sp_c);
    }
    return l;
}
def parse_and(p) -> list {
    l = parse_not(p);
    while patIdent(p, "and") {
        sp_l = pcur(p)[2]; sp_c = pcur(p)[3];
        padv(p);
        l = mk_ex_bin("and", l, parse_not(p), sp_l, sp_c);
    }
    return l;
}
def parse_not(p) -> list {
    if patIdent(p, "not") {
        sp_l = pcur(p)[2]; sp_c = pcur(p)[3];
        padv(p);
        return mk_ex_unary("not", parse_not(p), sp_l, sp_c);
    }
    return parse_comparison(p);
}
def parse_comparison(p) -> list {
    l = parse_range(p);
    while (pcur(p)[0] == K_OP and is_cmp_tok(pcur(p)[1])) or
          patIdent(p, "is") or patIdent(p, "in") {
        sp_l = pcur(p)[2]; sp_c = pcur(p)[3];
        op = padv(p)[1];
        l = mk_ex_bin(op, l, parse_range(p), sp_l, sp_c);
    }
    return l;
}
def parse_range(p) -> list {
    l = parse_bit_or(p);
    if patOp(p, "..") or patOp(p, "..=") {
        op = pcur(p)[1];
        sp_l = pcur(p)[2]; sp_c = pcur(p)[3];
        n = pcur(p, 1);
        closed = n[0] == K_EOF or n[0] == K_NEWLN or n[0] == K_DEDENT or
                 (n[0] == K_PUNCT and
                  (n[1] == "]" or n[1] == ")" or n[1] == "}" or
                   n[1] == "," or n[1] == ":"));
        padv(p);
        r = if closed { [] } else { parse_bit_or(p) };
        return mk_ex_bin(op, l, r, sp_l, sp_c);
    }
    return l;
}
def parse_bit_or(p) -> list {
    l = parse_bit_xor(p);
    while patOp(p, "|") {
        sp_l = pcur(p)[2]; sp_c = pcur(p)[3];
        padv(p);
        l = mk_ex_bin("|", l, parse_bit_xor(p), sp_l, sp_c);
    }
    return l;
}
def parse_bit_xor(p) -> list {
    l = parse_bit_and(p);
    while patOp(p, "^") {
        sp_l = pcur(p)[2]; sp_c = pcur(p)[3];
        padv(p);
        l = mk_ex_bin("^", l, parse_bit_and(p), sp_l, sp_c);
    }
    return l;
}
def parse_bit_and(p) -> list {
    l = parse_shift(p);
    while patOp(p, "&") {
        sp_l = pcur(p)[2]; sp_c = pcur(p)[3];
        padv(p);
        l = mk_ex_bin("&", l, parse_shift(p), sp_l, sp_c);
    }
    return l;
}
def parse_shift(p) -> list {
    l = parse_arith(p);
    while patOp(p, "<<") or patOp(p, ">>") {
        op = pcur(p)[1];
        sp_l = pcur(p)[2]; sp_c = pcur(p)[3];
        padv(p);
        l = mk_ex_bin(op, l, parse_arith(p), sp_l, sp_c);
    }
    return l;
}
def parse_arith(p) -> list {
    l = parse_term(p);
    while patOp(p, "+") or patOp(p, "-") {
        op = pcur(p)[1];
        sp_l = pcur(p)[2]; sp_c = pcur(p)[3];
        padv(p);
        l = mk_ex_bin(op, l, parse_term(p), sp_l, sp_c);
    }
    return l;
}
def parse_term(p) -> list {
    l = parse_unary(p);
    while patOp(p, "*") or patOp(p, "/") or patOp(p, "%") or patOp(p, "//") {
        op = pcur(p)[1];
        sp_l = pcur(p)[2]; sp_c = pcur(p)[3];
        padv(p);
        l = mk_ex_bin(op, l, parse_unary(p), sp_l, sp_c);
    }
    return l;
}
def parse_unary(p) -> list {
    if patIdent(p, "try") {
        e = mk_ex_unary("try", [], pcur(p)[2], pcur(p)[3]);
        padv(p);
        e[3] = parse_unary(p);
        return e;
    }
    if patOp(p, "-") or patOp(p, "+") or patOp(p, "~") or
       patOp(p, "&") or patOp(p, "*") or patIdent(p, "not") {
        e = mk_ex_unary("", [], pcur(p)[2], pcur(p)[3]);
        e[2] = padv(p)[1];
        e[3] = parse_unary(p);
        return e;
    }
    return parse_power(p);
}
def parse_power(p) -> list {
    l = parse_postfix(p);
    if patOp(p, "**") {
        sp_l = pcur(p)[2]; sp_c = pcur(p)[3];
        padv(p);
        l = mk_ex_bin("**", l, parse_unary(p), sp_l, sp_c);
    }
    while patIdent(p, "as") {
        padv(p);
        c = ["E", "Cast", [], [], l[4], l[5]];
        c[3] = l;
        c[6] = parse_type(p);
        l = c;
    }
    return l;
}
def parse_call_arg(p) -> list {
    a = ["carg", "", []];
    if pcur(p)[0] == K_IDENT and patPunct(p, ":", 1) and not patIdent(p, "if") {
        a[1] = padv(p)[1];
        padv(p);
    }
    a[2] = parse_expr(p);
    return a;
}
def parse_index_body(p, obj) -> list {
    pexpect_punct(p, "[");
    idx = ["E", "Index", obj, [], [], pcur(p)[2], pcur(p)[3]];
    if patPunct(p, ":") {
        padv(p);
        idx[1] = "Slice";
        idx[2] = ":";
        idx[5] = [obj];
        if patPunct(p, ":") or patPunct(p, "]") { idx[5].append([]); }
        else { idx[5].append(parse_expr(p)); }
        if patPunct(p, ":") {
            padv(p);
            if patPunct(p, "]") { idx[5].append([]); }
            else { idx[5].append(parse_expr(p)); }
        }
        pexpect_punct(p, "]");
        return idx;
    }
    first = parse_expr(p);
    if patPunct(p, ":") {
        padv(p);
        idx[1] = "Slice";
        idx[2] = ":";
        idx[5] = [obj];
        idx[5].append(first);
        if patPunct(p, ":") or patPunct(p, "]") { idx[5].append([]); }
        else { idx[5].append(parse_expr(p)); }
        if patPunct(p, ":") {
            padv(p);
            if patPunct(p, "]") { idx[5].append([]); }
            else { idx[5].append(parse_expr(p)); }
        }
        pexpect_punct(p, "]");
        return idx;
    }
    idx[3] = first;
    pexpect_punct(p, "]");
    return idx;
}
def parse_postfix(p) -> list {
    e = parse_primary(p);
    while true {
        if patPunct(p, "(") {
            padv(p);
            c = ["E", "Call", [], e, pcur(p)[2], pcur(p)[3]];
            while not patPunct(p, ")") {
                if patPunct(p, ",") { padv(p); continue; }
                c[5].append(parse_call_arg(p));
                if patPunct(p, ",") { padv(p); } else { break; }
            }
            pexpect_punct(p, ")");
            e = c;
            continue;
        }
        if patPunct(p, "[") {
            e = parse_index_body(p, e);
            continue;
        }
        if patPunct(p, ".") or patOp(p, ".?.") {
            nil_safe = pcur(p)[0] == K_OP and pcur(p)[1] == ".?.";
            padv(p);
            m = ["E", "Member", [], e, pcur(p)[2], pcur(p)[3]];
            m[5] = nil_safe;
            m[6] = pexpect(p, K_IDENT, "member name")[1];
            e = m;
            continue;
        }
        if patOp(p, "?") {
            padv(p);
            t = ["E", "Try", [], e, pcur(p)[2], pcur(p)[3]];
            e = t;
            continue;
        }
        break;
    }
    return e;
}
def parse_primary(p) -> list {
    sp_l = pcur(p)[2];
    sp_c = pcur(p)[3];
    t = pcur(p);
    k = t[0];
    if k == K_INT or k == K_FLOAT {
        padv(p);
        return mk_ex_leaf((if k == K_INT { "Int" } else { "Float" }), t[1], "", t[2], t[3]);
    }
    if k == K_CHAR {
        padv(p);
        return mk_ex_leaf("Char", t[1], "", t[2], t[3]);
    }
    if k == K_STR or k == K_STRRAW or k == K_STRBYT or k == K_STRC {
        padv(p);
        fl = "";
        if k == K_STRRAW { fl = " r"; }
        if k == K_STRBYT { fl = " b"; }
        if k == K_STRC { fl = " c"; }
        return mk_ex_leaf("Str", t[1], fl, t[2], t[3]);
    }
    if k == K_FSTR {
        padv(p);
        e = ["E", "FString", [], [], sp_l, sp_c];
        while not pat(p, K_FSTEND) and not pat(p, K_EOF) {
            if pat(p, K_FSTRTX) {
                tt = pcur(p);
                part = ["fpart", false, tt[1], [], "", tt[2], tt[3]];
                e[5].append(part);
                padv(p);
                continue;
            }
            if pat(p, K_FSTRLB) {
                padv(p);
                sub = [];
                depth = 0;
                spec = "";
                saw_spec = false;
                while not pat(p, K_EOF) {
                    if pat(p, K_FSTRRB) and depth == 0 { break; }
                    if pat(p, K_FSTRCO) and depth == 0 { saw_spec = true; break; }
                    if patPunct(p, "{") { depth = depth + 1; }
                    if patPunct(p, "}") { depth = depth - 1; }
                    sub.append(pcur(p));
                    padv(p);
                }
                if saw_spec {
                    padv(p);
                    if pat(p, K_FSTRSP) { spec = pcur(p)[1]; padv(p); }
                }
                pexpect_kind(p, K_FSTRRB, "'}' closing interpolation");
                sub.append(["Eof", "", 0, 0]);
                sub[len(sub) - 1][0] = "Eof";
                sub_parser = new_parser(sub);
                part = ["fpart", true, [], [], spec, sp_l, sp_c];
                part[2] = parse_expr(sub_parser);
                e[5].append(part);
                continue;
            }
            c2 = pcur(p);
            preport(p, c2[2], c2[3], "malformed f-string");
            padv(p);
        }
        if pat(p, K_FSTEND) { padv(p); }
        return e;
    }
    if k == K_IDENT {
        if (t[1] == "chan") and (patPunct(p, "[", 1) or patPunct(p, "(", 1)) {
            e = ["E", "New", [], [], sp_l, sp_c];
            e[6] = parse_base_type(p);
            return e;
        }
        if t[1] == "new" {
            padv(p);
            e = ["E", "New", [], [], sp_l, sp_c];
            e[6] = parse_base_type(p);
            return e;
        }
        if is_kw(t[1]) {
            if t[1] == "none" or t[1] == "true" or t[1] == "false" or t[1] == "self" {
                padv(p);
                return mk_ex_leaf("Ident", t[1], "", t[2], t[3]);
            }
            preport(p, t[2], t[3], "unexpected keyword '" + t[1] + "' in expression");
            perr(p, "kwexpr");
        }
        padv(p);
        return mk_ex_leaf("Ident", t[1], "", t[2], t[3]);
    }
    if patPunct(p, "(") {
        lam = try_parse_lambda(p);
        if lam != [] { return lam; }
        padv(p);
        if patPunct(p, ")") {
            padv(p);
            return ["E", "Tuple", [], [], sp_l, sp_c];
        }
        first = parse_expr(p);
        if patPunct(p, ",") {
            e = ["E", "Tuple", [], [], sp_l, sp_c];
            e[4] = [first];
            while patPunct(p, ",") {
                padv(p);
                if patPunct(p, ")") { break; }
                e[4].append(parse_expr(p));
            }
            pexpect_punct(p, ")");
            return e;
        }
        pexpect_punct(p, ")");
        return first;
    }
    if patPunct(p, "[") {
        padv(p);
        e = ["E", "List", [], [], sp_l, sp_c];
        if not patPunct(p, "]") {
            first = parse_expr(p);
            if patIdent(p, "for") {
                e = parse_comp_expr(p, first);
                e[1] = "ListComp";
            } else {
                e[4] = [first];
                while patPunct(p, ",") {
                    padv(p);
                    if patPunct(p, "]") { break; }
                    e[4].append(parse_expr(p));
                }
            }
        }
        pexpect_punct(p, "]");
        return e;
    }
    if patPunct(p, "{") {
        padv(p);
        e = ["E", "Dict", [], [], sp_l, sp_c];
        if patPunct(p, "}") {
            padv(p);
            return e;
        }
        first_key = parse_expr(p);
        if patPunct(p, ":") {
            padv(p);
            e[4] = [];
            e[4] = [[first_key, parse_expr(p)]];
            while patPunct(p, ",") {
                padv(p);
                if patPunct(p, "}") { break; }
                kk = parse_expr(p);
                pexpect_punct(p, ":");
                e[4].append([kk, parse_expr(p)]);
            }
        } else {
            e[1] = "Set";
            e[4] = [first_key];
            while patPunct(p, ",") {
                padv(p);
                if patPunct(p, "}") { break; }
                e[4].append(parse_expr(p));
            }
        }
        pexpect_punct(p, "}");
        return e;
    }
    preport(p, t[2], t[3], "expected expression, found '" + t[1] + "'");
    perr(p, "primary");
    return [];
}

# ---- main -------------------------------------------------------------------
def main() -> int {
    print("M1 entered main");
    args = os.args();
    want_ast = false;
    path = "";
    for a in args {
        if a == "--ast" { want_ast = true; }
        else { path = a; }
    }
    if path == "" {
        print("usage: parse [--ast] <file.co>");
        return 2;
    }
    src = core.read_file(path);
    st = lex.new_lex(src);
    toks = lex.take_all(st);
    lex_errors = len(st["diags"]);
    parse_errors = 0;
    total = lex_errors;
    if lex_errors == 0 {
        print("M2 lexing done, toks=" + str(len(toks)));
        lb = [];
        for t in toks { lb.append(t); }
        p = new_parser(lb);
        prog = parse_program(p);
        parse_errors = len(p["diags"]);
        if want_ast {
            out_buffer = [];
            for stmt in prog { dump_stmt(stmt, 0); }
            for l in out_buffer { print(l); }
        }
        if parse_errors == 0 {
            print(path + ": OK (" + str(len(prog)) + " top-level statements)");
        }
        for d in p["diags"] {
            print(path + ":" + str(d[0]) + ":" + str(d[1]) + ": error: " + str(d[2]));
        }
        total = len(p["diags"]);
    }
    for d in st["diags"] {
        print(path + ":" + str(d[0]) + ":" + str(d[1]) + ": error: " + str(d[2]));
    }
    if total == 0 { return 0; }
    print(path + ": " + str(total) + " error(s) (" + str(lex_errors) +
          " lex, " + str(parse_errors) + " parse)");
    return 1;
}